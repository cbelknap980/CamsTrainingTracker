  "exercises": {
    "back_squat": {
      "name": "Back squat",
      "logName": "Back squat",
      "equipment": "barbell",
      "mainLift": true,
      "benchmark": true,
      "cue": "Regular back squat. Build depth over the first two weeks before adding weight. Knee sharp? Squat to a box with a 3-s lowering instead.",
      "short": "Squat",
      "tempo": [
        3,
        0,
        1,
        2
      ],
      "tips": [
        "Big breath and brace before every rep.",
        "Control the way down, drive up fast."
      ]
    },
    "rdl": {
      "name": "Romanian deadlift",
      "equipment": "barbell",
      "mainLift": false,
      "benchmark": true,
      "cue": "Hinge, soft knees, bar close.",
      "short": "RDL",
      "tempo": [
        3,
        0,
        1,
        1
      ],
      "tips": [
        "Push the hips back until the hamstrings stretch.",
        "Bar stays against the legs; back flat."
      ]
    },
    "calf_raise": {
      "name": "Standing calf raise",
      "equipment": "machine",
      "mainLift": false,
      "cue": "Pause at the bottom.",
      "short": "Calf",
      "tempo": [
        2,
        2,
        1,
        1
      ],
      "tips": [
        "Full stretch and a 2-second pause at the bottom.",
        "Squeeze at the top; no bouncing."
      ]
    },
    "bss": {
      "name": "Bulgarian split squat",
      "equipment": "dumbbell",
      "mainLift": false,
      "perSide": true,
      "cue": "Tuck the pelvis on the back leg.",
      "short": "Split sq",
      "tempo": [
        3,
        0,
        1,
        0.5
      ],
      "tips": [
        "Slow down, front foot flat, knee tracks over toes.",
        "Lean slightly forward and drive through the front heel."
      ],
      "pair": true
    },
    "leg_curl": {
      "name": "Seated leg curl",
      "equipment": "machine",
      "mainLift": false,
      "short": "Leg curl",
      "tempo": [
        3,
        0,
        1,
        1
      ],
      "tips": [
        "Squeeze hard at the bottom of the curl.",
        "Take 3 seconds letting the pad back up."
      ]
    },
    "curl": {
      "name": "Standing dumbbell curl",
      "equipment": "dumbbell",
      "mainLift": false,
      "short": "Standing curl",
      "tempo": [
        2,
        0,
        1,
        0.5
      ],
      "tips": [
        "Elbows pinned to your sides; no swing.",
        "Lower all the way to straight arms."
      ],
      "logName": "Standing dumbbell curl",
      "pair": true
    },
    "oh_tri_ext": {
      "name": "Overhead triceps extension",
      "equipment": "dumbbell",
      "mainLift": false,
      "short": "Tri ext",
      "tempo": [
        2,
        1,
        1,
        0
      ],
      "tips": [
        "Let the weight sink for a deep stretch behind the head.",
        "Elbows point up and stay in."
      ]
    },
    "ab_wheel": {
      "name": "Ab wheel",
      "equipment": "bodyweight",
      "mainLift": false,
      "cue": "Pelvis tucked.",
      "short": "Ab wheel",
      "tempo": [
        3,
        0,
        2,
        0
      ],
      "tips": [
        "Ribs down, glutes tight; hips must not sag.",
        "Only roll out as far as you can hold that shape."
      ]
    },
    "strict_press": {
      "name": "Strict press",
      "equipment": "barbell",
      "mainLift": true,
      "benchmark": true,
      "cue": "Couch stretch during the rests.",
      "short": "Press",
      "tempo": [
        2,
        0,
        1,
        1.5
      ],
      "tips": [
        "Squeeze glutes and abs; no lean back.",
        "Bar travels straight up, head through at the top."
      ]
    },
    "weighted_pullup": {
      "name": "Weighted pull-up",
      "equipment": "weighted_bw",
      "mainLift": true,
      "benchmark": true,
      "cue": "30-45 s dead hang after the last set.",
      "short": "Pull-up",
      "tempo": [
        2,
        0,
        1,
        1
      ],
      "tips": [
        "Start every rep from a dead hang.",
        "Chest to the bar, then lower under control."
      ]
    },
    "incline_db_press": {
      "name": "Incline dumbbell press",
      "equipment": "dumbbell",
      "mainLift": false,
      "short": "Inc press",
      "cue": "Bench at about 30 degrees.",
      "tempo": [
        2,
        1,
        1,
        0
      ],
      "tips": [
        "Lower until you feel the upper chest stretch, pause, press.",
        "Shoulder blades pinned back and down; a steeper bench turns this into a shoulder press."
      ],
      "pair": true
    },
    "cs_row": {
      "name": "Chest-supported row",
      "equipment": "machine",
      "mainLift": false,
      "short": "Row",
      "tempo": [
        2,
        0,
        1,
        1
      ],
      "tips": [
        "Pull the elbows back and squeeze for a second.",
        "Chest stays on the pad; let the shoulders reach forward at the bottom."
      ]
    },
    "lateral_raise": {
      "name": "Lateral raise",
      "equipment": "dumbbell",
      "mainLift": false,
      "short": "Lat raise",
      "tempo": [
        2,
        0,
        1,
        0.5
      ],
      "tips": [
        "Lead with the elbows, raise out and slightly forward.",
        "Lower slowly; no shrugging or swinging."
      ],
      "pair": true
    },
    "incline_curl": {
      "name": "Incline dumbbell curl",
      "equipment": "dumbbell",
      "mainLift": false,
      "short": "Incline curl",
      "tempo": [
        3,
        1,
        1,
        0
      ],
      "tips": [
        "Arms hang straight down behind the body; feel the stretch.",
        "Shoulders stay back on the bench."
      ],
      "pair": true
    },
    "t2b": {
      "name": "Toes-to-bar",
      "equipment": "bodyweight",
      "mainLift": false,
      "short": "T2B",
      "tempo": [
        1,
        0,
        1,
        0.5
      ],
      "tips": [
        "Start each rep by pressing down on the bar with straight arms.",
        "Control the swing down; no wild kip."
      ]
    },
    "face_pull": {
      "name": "Face pull",
      "equipment": "cable",
      "mainLift": false,
      "short": "Face pull",
      "tempo": [
        2,
        0,
        1,
        1
      ],
      "tips": [
        "Pull to eye level, hands apart, thumbs back.",
        "Hold the squeeze for a second."
      ]
    },
    "power_clean": {
      "name": "Power clean",
      "equipment": "barbell",
      "mainLift": true,
      "benchmark": true,
      "autoProgress": false,
      "cue": "Fast. Hang power clean if the catch bothers the knee.",
      "short": "Clean",
      "tempo": [
        1,
        0,
        1,
        5
      ],
      "tips": [
        "Patient off the floor, then jump hard.",
        "Fast elbows; reset fully between reps."
      ]
    },
    "front_squat": {
      "name": "Front squat",
      "equipment": "barbell",
      "mainLift": true,
      "benchmark": true,
      "short": "Front sq",
      "tempo": [
        3,
        0,
        1,
        2
      ],
      "tips": [
        "Elbows high the whole rep.",
        "Sit straight down, chest tall, drive up fast."
      ]
    },
    "push_press": {
      "name": "Push press",
      "equipment": "barbell",
      "mainLift": true,
      "benchmark": true,
      "cue": "Or seated DB press.",
      "short": "Push press",
      "tempo": [
        1,
        0,
        1,
        2.5
      ],
      "tips": [
        "Short, straight dip with heels down.",
        "Drive hard with the legs, then punch to lockout."
      ]
    },
    "db_row": {
      "name": "Dumbbell row",
      "equipment": "dumbbell",
      "mainLift": false,
      "cue": "Or chest-supported row.",
      "short": "DB row",
      "tempo": [
        2,
        0,
        1,
        1
      ],
      "tips": [
        "Pull the elbow toward the hip, not straight up.",
        "Full stretch at the bottom; no torso twist."
      ]
    },
    "preacher_curl": {
      "name": "Dumbbell preacher curl",
      "equipment": "dumbbell",
      "mainLift": false,
      "short": "Preacher curl",
      "tempo": [
        3,
        1,
        1,
        0
      ],
      "tips": [
        "Lower to nearly straight and pause in the stretch.",
        "Upper arm stays glued to the pad."
      ]
    },
    "rope_pushdown": {
      "name": "Rope pushdown",
      "equipment": "cable",
      "mainLift": false,
      "short": "Pushdown",
      "tempo": [
        2,
        0,
        1,
        1
      ],
      "tips": [
        "Elbows stay at your sides.",
        "Spread the rope and squeeze at the bottom."
      ]
    },
    "side_plank": {
      "name": "Side plank",
      "equipment": "bodyweight",
      "mainLift": false,
      "perSide": true,
      "timed": true,
      "cue": "Pelvis tucked. Copenhagen plank once this is easy.",
      "short": "Side plank",
      "tips": [
        "Straight line from head to heels, hips pushed forward."
      ]
    }
  },
